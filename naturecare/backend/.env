# Nature Care Backend - Environment Configuration
# Copy this file to .env and update values as needed

# Database Configuration
# For local MongoDB: mongodb://localhost:27017/nature-care
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/nature-care
MONGODB_URI=mongodb+srv://dilip:rockport@dsislearning.6spjq6y.mongodb.net/?appName=dsislearning

# JWT Secret Key
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=helloworld

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5500

# Optional: Email Configuration (for future email features)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Optional: Payment Gateway (for future integration)
# STRIPE_SECRET_KEY=sk_test_your_stripe_key
# PAYPAL_CLIENT_ID=your_paypal_client_id

# Optional: Cloud Storage (for image uploads)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_BUCKET_NAME=nature-care-bucket
